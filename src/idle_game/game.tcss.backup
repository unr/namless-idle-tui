/* Emotion Merchant - TUI Styling */

/* === Global App Styles === */
Screen {
    background: $surface;
}

/* === Title Banner === */
#title-banner {
    height: 5;
    background: $primary;
    color: $text;
    border: heavy $accent;
    margin: 1;
    padding: 1;
}

#game-title {
    text-align: center;
    text-style: bold;
    color: $warning;
    content-align: center middle;
}

#game-subtitle {
    text-align: center;
    color: $text-muted;
    content-align: center middle;
}

/* === Main Layout === */
#game-container {
    height: 100%;
    padding: 0;
}

#main-area {
    height: 1fr;
    margin: 0 1;
}

/* === Panel Layouts === */
#left-panel {
    width: 1fr;
    border: solid $primary;
    background: $panel;
    padding: 1;
    margin: 0 1 0 0;
}

#center-panel {
    width: 2fr;
    border: solid $accent;
    background: $panel;
    padding: 1;
    margin: 0 1;
}

#right-panel {
    width: 1fr;
    border: solid $primary;
    background: $panel;
    padding: 1;
    margin: 0 0 0 1;
}

.panel-header {
    text-style: bold;
    color: $accent;
    text-align: center;
    background: $surface-darken-1;
    padding: 1;
    border: solid $primary-lighten-1;
    margin-bottom: 1;
}

/* === Resource Panel Styles === */
#resource-panel {
    height: auto;
}

.resource-item {
    height: auto;
    border: solid $primary-darken-1;
    background: $surface;
    padding: 1;
    margin: 1 0;
}

.resource-item.locked {
    opacity: 0.5;
    background: $surface-darken-2;
}

.resource-header {
    height: 1;
    width: 100%;
}

.resource-symbol {
    width: 4;
    text-align: center;
    text-style: bold;
    color: $warning;
}

.resource-name {
    width: 1fr;
    text-style: bold;
    color: $text;
}

.resource-amount {
    width: auto;
    text-align: right;
    color: $success;
    text-style: bold;
}

.resource-storage {
    height: 1;
    width: 100%;
    margin-top: 1;
}

.storage-bar {
    width: 2fr;
    color: $primary;
}

.capacity-text {
    width: 1fr;
    text-align: right;
    color: $text-muted;
}

.resource-info {
    height: 1;
    width: 100%;
    margin-top: 1;
}

.purity-indicator {
    width: 1fr;
    color: $accent;
}

.production-rate {
    width: 1fr;
    text-align: right;
    color: $success;
}

/* === Action Buttons Styles === */
#action-buttons {
    height: auto;
}

#click-section {
    border: solid $accent;
    background: $surface-lighten-1;
    padding: 1;
    margin-bottom: 2;
}

.section-header {
    text-style: bold;
    color: $accent;
    text-align: center;
    background: $surface-darken-1;
    padding: 1;
    margin-bottom: 1;
}

.click-info {
    height: 1;
    width: 100%;
    margin: 1 0;
}

.info-label {
    width: auto;
    color: $text-muted;
}

#click-power-display {
    width: 1fr;
    text-align: right;
    color: $warning;
    text-style: bold;
}

.action-button-large {
    width: 100%;
    height: 3;
    margin: 1 0;
}

#harvest-button {
    background: $success;
    color: $text;
    text-style: bold;
    border: heavy $success-lighten-1;
}

#harvest-button:hover {
    background: $success-lighten-1;
}

#harvest-button:focus {
    background: $success-lighten-2;
    border: heavy $warning;
}

#click-counter {
    text-align: center;
    color: $text-muted;
    margin-top: 1;
}

/* === Producers Section === */
#producers-section {
    border: solid $primary;
    background: $surface-lighten-1;
    padding: 1;
}

#producers-list {
    height: auto;
}

.producer-button {
    border: solid $primary-darken-1;
    background: $surface;
    padding: 1;
    margin: 1 0;
    height: auto;
}

.producer-button.locked {
    opacity: 0.4;
    background: $surface-darken-2;
}

.producer-header {
    height: 1;
    width: 100%;
}

.producer-name {
    width: 1fr;
    text-style: bold;
    color: $accent;
}

.producer-count {
    width: auto;
    text-align: right;
    color: $success;
}

.producer-description {
    color: $text-muted;
    margin: 1 0;
}

.producer-production {
    color: $text;
    margin-bottom: 1;
}

.producer-footer {
    height: 3;
    width: 100%;
}

.producer-cost {
    width: 1fr;
    content-align: center middle;
    color: $warning;
    text-style: bold;
}

.buy-button {
    width: auto;
    min-width: 10;
}

.unlock-hint {
    text-align: center;
    color: $text-muted;
    text-style: italic;
    margin: 2 0;
}

/* === Event Display === */
#event-container {
    margin-top: 2;
    border: solid $warning;
    background: $surface-lighten-1;
    padding: 1;
    min-height: 5;
}

#event-display {
    color: $text;
    text-align: center;
    content-align: center middle;
}

/* === Statistics Panel === */
#stat-display {
    height: auto;
}

#core-stats {
    border: solid $primary-darken-1;
    background: $surface;
    padding: 1;
    margin-bottom: 2;
}

#stats-grid {
    grid-size: 1;
    grid-gutter: 1;
}

.stat-item {
    height: 1;
    width: 100%;
    margin: 1 0;
}

.stat-label {
    width: 1fr;
    color: $text-muted;
}

.stat-value {
    width: auto;
    text-align: right;
    color: $success;
    text-style: bold;
}

/* === Reputation Section === */
#reputation-stats {
    border: solid $accent;
    background: $surface;
    padding: 1;
    margin-bottom: 2;
}

#mood-rating-display {
    width: auto;
    text-align: right;
    color: $warning;
}

#ethical-score-bar {
    width: 1fr;
    height: 1;
    color: $success;
}

/* === Production Rates === */
.production-rates {
    border: solid $success;
    background: $surface;
    padding: 1;
    margin-bottom: 2;
}

.subsection-header {
    text-style: bold;
    color: $text;
    margin-bottom: 1;
}

#rates-list {
    height: auto;
}

.rate-item {
    color: $success;
    margin: 1 0;
}

#rates-placeholder {
    color: $text-muted;
    text-style: italic;
    text-align: center;
}

/* === Prestige Section === */
.prestige-info {
    border: solid $warning;
    background: $surface;
    padding: 1;
}

.prestige-locked {
    color: $text-muted;
    text-style: italic;
    text-align: center;
    margin: 1;
}

/* === Scrollable Containers === */
#resource-scroll {
    height: 1fr;
    overflow-y: scroll;
}

#stats-scroll {
    height: 1fr;
    overflow-y: scroll;
}

/* === Color Theme === */
/* Using emotional theme colors */
$primary: #6366f1;          /* Indigo - calm, trustworthy */
$accent: #f59e0b;           /* Amber - warm, inviting */
$success: #10b981;          /* Emerald - growth, positive */
$warning: #eab308;          /* Yellow - attention, joy */
$error: #ef4444;            /* Red - danger, passion */

$panel: #1e293b;            /* Slate dark */
$surface: #0f172a;          /* Slate darker */

/* === Button Variants === */
Button.primary {
    background: $primary;
    color: white;
}

Button.primary:hover {
    background: $primary-lighten-1;
}

Button.success {
    background: $success;
    color: white;
}

Button.success:hover {
    background: $success-lighten-1;
}

Button:disabled {
    opacity: 0.5;
}

/* === Progress Bars === */
ProgressBar {
    height: 1;
}

ProgressBar > .bar--bar {
    color: $success;
}

ProgressBar > .bar--complete {
    color: $success-lighten-2;
}

/* === Responsive Adjustments === */
/* Textual CSS doesn't support @media queries, using alternative approach */
/* @media (max-width: 100) {
    #left-panel, #right-panel {
        display: none;
    }

    #center-panel {
        width: 100%;
        margin: 0;
    }
} */

/* === Focus and Hover States === */
*:focus {
    border: heavy $accent;
}

Static:hover {
    background: $surface-lighten-1;
}

Button:focus {
    border: heavy $warning;
}

/* === Animations === */
/* Textual CSS doesn't support @keyframes */
/*
@keyframes pulse {
    0%, 100% {
        opacity: 1;
    }
    50% {
        opacity: 0.7;
    }
}

.pulse {
    animation: pulse 2s ease-in-out infinite;
}
*/
