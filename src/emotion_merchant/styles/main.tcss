/* Main Application Styles */

Screen {
    background: $surface;
}

/* Header */
#game-header {
    dock: top;
    height: 3;
    background: $primary;
    color: $text;
    text-align: center;
    padding: 1;
}

/* Footer */
#game-footer {
    dock: bottom;
    height: 3;
    background: $primary-darken-2;
}

/* Main Layout */
#main-container {
    layout: grid;
    grid-size: 3;
    grid-columns: 1fr 2fr 1fr;
    height: 100%;
}

/* Left Panel - Resources */
#left-panel {
    height: 100%;
    border: solid $primary;
    padding: 1;
}

/* Center Panel - Main Game Area */
#center-panel {
    height: 100%;
    padding: 1;
}

/* Right Panel - Customers/Shop */
#right-panel {
    height: 100%;
    border: solid $primary;
    padding: 1;
}

/* Panel Titles */
.panel-title {
    text-style: bold;
    color: $text;
    background: $primary;
    padding: 0 1;
    margin-bottom: 1;
    text-align: center;
}

/* Resource Display */
.resource-row {
    height: 3;
    margin-bottom: 1;
}

.resource-name {
    width: 15;
    color: $text;
}

.resource-amount {
    width: 12;
    text-align: right;
    color: $success;
}

.resource-rate {
    width: 10;
    text-align: right;
    color: $warning;
}

ResourceDisplay {
    height: auto;
    margin-bottom: 1;
}

ResourceDisplay ProgressBar {
    width: 1fr;
    margin: 0 1;
}

/* Clicker Widget */
ClickerWidget {
    height: auto;
    border: double $success;
    padding: 1;
    margin: 1;
}

#clicker-title {
    text-style: bold;
    text-align: center;
    color: $warning;
}

#harvest-btn {
    width: 100%;
    height: 5;
    margin: 1 0;
}

/* Customer Panel */
.customer-card {
    height: 5;
    border: solid $secondary;
    margin-bottom: 1;
    padding: 1;
}

.customer-avatar {
    width: 4;
}

.customer-info {
    width: 1fr;
}

.customer-name {
    text-style: bold;
}

.serve-btn {
    width: 10;
}

.tutorial-highlight {
    border: double $warning;
    padding: 1;
    margin: 1;
}

/* Stats Display */
#stats-panel {
    height: auto;
    border: solid $primary;
    padding: 1;
    margin-top: 1;
}

/* Notifications */
#notification-area {
    dock: bottom;
    height: auto;
    max-height: 5;
    background: $surface-darken-1;
    padding: 0 1;
}
